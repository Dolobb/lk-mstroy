KIP_DB_HOST=localhost
KIP_DB_PORT=5432                          # Всегда 5432 (PG16)
KIP_DB_NAME=kip_vehicles
KIP_DB_USER=postgres
KIP_DB_PASSWORD=

MAIN_DB_HOST=localhost
MAIN_DB_PORT=5432                         # Windows: 5432; macOS: 5433
MAIN_DB_NAME=mstroy
MAIN_DB_USER=postgres
MAIN_DB_PASSWORD=

# Alerts / notifications
# ALERT_DRY_RUN=true renders complete emails into admin logs and does not send SMTP.
ALERT_ENABLED=true
ALERT_DRY_RUN=true
ALERT_EMAIL_TO=pisarenkovmaxim@gmail.com
ALERT_THROTTLE_HOURS=6
DOWNTIME_ALERT_HOURS=6
ALERT_DIGEST_ALWAYS=false

# SMTP credentials. Leave empty in dry-run mode.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# External downtime watchdog (healthchecks.io). Empty value disables heartbeat pings.
HEARTBEAT_URL=
HEARTBEAT_INTERVAL_MS=900000

# PIN for the admin section (4 digits). Changing it logs everyone out. Empty = admin is NOT protected.
ADMIN_PIN=
