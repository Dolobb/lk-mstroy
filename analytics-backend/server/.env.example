# PostgreSQL (mstroy — PG17, порт 5432 на Windows / 5433 на Mac)
# Оба PG инстанса используют юзера 'max' (как и admin/server.ts)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mstroy
DB_USER=max
DB_PASSWORD=

# KIP PostgreSQL (kip_vehicles — PG16, порт 5432)
KIP_DB_HOST=localhost
KIP_DB_PORT=5432
KIP_DB_NAME=kip_vehicles
KIP_DB_USER=max
KIP_DB_PASSWORD=

# External API (TIS)
TIS_API_URL=
TIS_API_TOKENS=token1,token2,token3

# Server
SERVER_PORT=3007
NODE_ENV=development
