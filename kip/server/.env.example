# PostgreSQL (kip_vehicles — основная БД сервиса КИП)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=kip_vehicles
DB_USER=postgres
DB_PASSWORD=

# External API (TIS)
TIS_API_URL=
TIS_API_TOKENS=token1,token2,token3

# Rate limiting
RATE_LIMIT_PER_VEHICLE_MS=30000

# Server
SERVER_PORT=3001
NODE_ENV=development

# Main DB (mstroy) — второй пул getMainPool():
#   - geo.zones (геозоны)
#   - ingest.tasks / ingest.task_events (write-through ledger)
MAIN_DB_HOST=localhost
MAIN_DB_PORT=5432
MAIN_DB_NAME=mstroy
MAIN_DB_USER=max
MAIN_DB_PASSWORD=
